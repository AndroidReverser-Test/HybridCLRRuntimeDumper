# No target RVAs, instruction fingerprints or object field offsets.
# Use stable_window_confirmed=1 only with a real application lifetime gate.
discovery_mode=auto
stable_window_confirmed=1
allow_ungated_capture=0
module_name=libil2cpp.so
initialization_timeout_seconds=30
chunk_size=262144
